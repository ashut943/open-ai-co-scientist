# Copy to .env (gitignored) and fill in. Keys come ONLY from the environment —
# never write one into code, config.yaml, fixtures, or logs (see AGENTS.md).

# Select "openai" (default, Parley/OpenAI-compatible) or "openrouter".
LLM_PROVIDER=openai

# Set the key for the selected provider. Offline `make test` needs no key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional literature-search settings (all free). An email gets you the
# "polite pool" on OpenAlex/Crossref/NCBI; keys raise rate limits.
LITERATURE_CONTACT_EMAIL=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
# CO_SCIENTIST_DISABLE_LITERATURE=1

# Upper limit for one Run Cycle in the UI (default 300). Cycle 2+ with a reasoning
# model makes ~30 sequential LLM calls; 1800 (30 min) is a safe local value.
# CO_SCIENTIST_CYCLE_TIMEOUT_SECONDS=1800
